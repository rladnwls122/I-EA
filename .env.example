# =====================================================================
# Q-Idea API 환경변수 양식
#   cp .env.example .env  후 값을 채운다. .env는 .gitignore 대상이다.
#   주석의 "기본값"은 값이 없을 때 코드가 실제로 쓰는 fallback이다.
# =====================================================================

# --- Database (MySQL / TiDB) --- [필수]
# 없으면 prisma validate/generate와 부팅이 모두 실패한다.
# 로컬 Docker 예시: mysql://user:password@localhost:3306/qidea
DATABASE_URL="mysql://user:password@localhost:3306/qidea"

# --- Redis (BullMQ) ---
# AI 문항 생성이 비동기 큐라, Redis가 없으면 생성 잡이 처리되지 않는다.
REDIS_HOST="127.0.0.1"                  # 기본값: 127.0.0.1
REDIS_PORT="6379"                       # 기본값: 6379
REDIS_PASSWORD=""                       # 없으면 비워둔다
# Aiven 등 관리형 Redis(TLS)만 "true". 로컬/Railway는 비워둔다.
REDIS_TLS=""

# --- Auth --- [필수]
# 코드에 fallback 기본값이 없다. 비어 있거나 아래 예시 문자열 그대로면 부팅이 중단된다.
# 운영은 32자 이상을 요구한다:  openssl rand -base64 48
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"                     # 기본값: 7d
# 토큰 무효화는 users.token_version으로 한다(POST /api/auth/logout-all).
# 별도 env는 없다.

# --- LLM (Gemini) ---
# 키가 없어도 부팅은 되지만, 생성 잡이 FAILED로 떨어진다.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"         # 기본값: gemini-2.5-flash
GEMINI_MAX_TOKENS="4096"                # 기본값: 4096
# 비워두면 https://generativelanguage.googleapis.com/v1beta 사용
GEMINI_BASE_URL=""

# --- 서버 ---
# 주의: Next.js 프론트(web/)도 3000을 쓴다. 동시 실행 시 하나를 바꿔야 한다.
PORT="3000"                             # 기본값: 3000
# production이면 검증이 강해진다(ALLOWED_ORIGINS 필수, JWT_SECRET 32자 이상).
NODE_ENV=""

# --- CORS --- [운영 필수]
# 콤마 구분 허용 origin 목록. 운영(NODE_ENV=production)에서 비어 있으면 부팅이 중단된다.
# 예전엔 비면 모든 origin을 반사(origin: true)했다 — 그 동작은 제거됐다.
# 비어 있고 개발 환경이면 localhost:3000/3001만 허용한다.
ALLOWED_ORIGINS=""
# Vercel 프리뷰 URL 접두. 설정하면 https://<접두>...vercel.app 만 추가로 허용한다.
# 예전의 /\.vercel\.app$/ 는 제3자가 배포한 vercel 사이트까지 전부 허용했으므로 제거됐다.
# 예: "qidea-web"
VERCEL_PREVIEW_PREFIX=""

# --- API 문서 ---
# 운영에서는 /api/docs를 기본으로 끈다(API 표면 무인증 공개 방지).
# 운영에서도 열어야 하면 "true".
ENABLE_SWAGGER=""

# --- S3 (미디어 업로드) ---
# 없어도 부팅은 되고, presign 호출 시점에 503으로 실패한다.
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# CloudFront 등 공개 베이스 URL. 없으면 버킷/리전 규칙으로 유도한다.
AWS_S3_PUBLIC_BASE_URL=""
